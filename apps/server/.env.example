NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# Pooled connection (used by Prisma Client at runtime — supports PgBouncer/Prisma Pooler)
DATABASE_URL="postgresql://user:password@localhost:5432/atlas_db"

# Direct connection (used by Prisma CLI: migrate, studio, generate — bypasses pooler)
# If not using a pooler, set DIRECT_URL equal to DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/atlas_db"

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Optional. Valid values: fatal | error | warn | info | debug | trace
# Defaults: debug (non-production), info (production)
# LOG_LEVEL=debug

# ── Graceful shutdown ─────────────────────────────────────────────────────────
# Time (ms) to drain existing connections before forcing exit on SIGTERM/SIGINT.
# SHUTDOWN_TIMEOUT_MS=10000

# ── Readiness probe ───────────────────────────────────────────────────────────
# Timeout (ms) for the DB ping used by GET /api/ready.
# READINESS_DB_TIMEOUT_MS=2000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Applied to all /api/* routes except /api/health and /api/ready.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100

# ── Body size ─────────────────────────────────────────────────────────────────
# Maximum JSON body size accepted by the /api router (express.json limit).
# BODY_LIMIT=1mb
